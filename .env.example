# Copy to .env for local development. Never commit real credentials.
ELEVENLABS_API_KEY=
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_SECRET_KEY=
COOKIE_SECURE=0
TRUSTED_HOSTS=
PORT=5000
MAX_CONTENT_LENGTH=104857600
LOG_LEVEL=INFO

# Local generation stays synchronous; async jobs require authentication and external services.
GENERATION_MODE=local
# local for development, s3 for durable production media.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/media
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
WORKER_POLL_SECONDS=3
JOB_LEASE_SECONDS=900
FFMPEG_TIMEOUT_SECONDS=1800
# Optional absolute path to a supported font in the worker image.
VIDSNAPAI_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
